# ZeroLeft Backend — Environment Configuration
# Copy this file to .env and fill in your actual values

# ─── MongoDB Atlas ───────────────────────────────────────
# Sign up free at https://www.mongodb.com/atlas
# Create a free M0 cluster, get your connection string
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=zeroleft

# ─── JWT Auth ────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Gmail SMTP ──────────────────────────────────────────
# HOW TO SET UP GMAIL APP PASSWORD:
# 1. Go to your Google Account → Security
# 2. Enable 2-Step Verification (if not already)
# 3. Search "App Passwords" → Create one for "Mail"
# 4. Copy the 16-character password and paste below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_16char_app_password
EMAIL_FROM=ZeroLeft <your_gmail@gmail.com>

# ─── Image Storage ───────────────────────────────────────
# Local backend/uploads storage is used when Cloudinary is not configured.
# Cloudinary is optional for production deployments.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
UPLOADS_DIR=uploads

# ─── Google Maps (Optional) ──────────────────────────────
# Basic directions (no key needed) — works out of the box
# For embedded maps: https://console.cloud.google.com → Enable Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_optional

# ─── App Config ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
APP_NAME=ZeroLeft
ENVIRONMENT=development
